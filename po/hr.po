#: data/io.github.Micro856.KittiesGtk.desktop.in:2
#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:7
msgid "Kitties"
msgstr "Mačkice"

#: data/io.github.Micro856.KittiesGtk.desktop.in:8
msgid "GTK;Cat;Cats;Kitty;Feline;Felines;Meow;Gary;Goober;Gully;Garfield;Rory;API;Image;Download;Random;"
msgstr "GTK;Mačka;Mačke;Mačkica;Mačij;Mjau;Gary;Goober;Gully;Garfield;Rory;API;Slike;Preuzmi;Nasumično"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:8
msgid "View random images of felines"
msgstr "Pogledaj nasumične slike mačija"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:10
msgid ""
"Kitties is an app that lets you display a random image of one of the "
"available cats."
msgstr ""
"Mačkice je aplikacija koja ti daje da pokažeš nasumičnu sliku od dostupnih "
"mačka."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:11
msgid ""
"These pictures come from various APIs including api.garythe.cat and rory.cat."
msgstr ""
"Ove slike dolaze sa raznim API-ovima uključujući api.garythe.cat i rory.cat."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:13
msgid "Features:"
msgstr "Značajke"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:15
msgid "Support for Multiple APIs"
msgstr "Podrška za više API-ova"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:16
msgid "Saving Cat Images"
msgstr "Spremanje slike mačka"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:17
msgid "Keyboard Navigation"
msgstr "Navigacije tipkovnicom"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:22
msgid "Marcel Mrówka"
msgstr "Marcel Mrówka"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:43
msgid "Main Window of Kitties showing an image of Gary"
msgstr "Glavni prozor Mačkica koja pokazuje sliku Garya"

