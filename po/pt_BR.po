#. This name is generic enough. Go ahead translate it.
#: data/io.github.Micro856.KittiesGtk.desktop.in.in:2 data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:7
#: src/application.vala:65 src/window.blp:6 src/window.blp:13
msgid "Kitties"
msgstr "Gatinhos"

#: data/io.github.Micro856.KittiesGtk.desktop.in.in:8
msgid "GTK;Cat;Cats;Kitty;Feline;Felines;Meow;Gary;Goober;Gully;Garfield;Rory;API;Image;Download;Random;"
msgstr "GTK;Gato;Gatos;Gatinhos;Felino;Felinos;Miau;Gary;Goober;Gully;Garfield;Rory;API;Imagem;Baixar;Aleatório;"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:8
msgid "View random images of felines"
msgstr "Ver imagens aleatórias de felinos"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:10
msgid "Kitties is an app that lets you display a random image of one of the available cats."
msgstr "Gatinhos é um aplicativo que te permite exibir uma imagem aleatória de um dos gatos disponíveis."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:11
msgid "These pictures come from various APIs including api.garythe.cat and rory.cat."
msgstr "Essas fotos vêm de várias APIs, incluindo api.garythe.cat e rory.cat."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:12
msgid "Features:"
msgstr "Recursos:"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:14
msgid "Support for Multiple APIs"
msgstr "Suporte a várias APIs"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:15
msgid "Saving & Copying Cat Images"
msgstr "Salvando e copiando imagens de gatos"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:16
msgid "Keyboard Navigation"
msgstr "Navegação por teclado"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:21
msgid "Marcel Mrówka"
msgstr "Marcel Mrówka"

# Coloquei do app Gatinhos em vez de do Gatinhos pois
# do (singular) briga não fica bem acompanhado de Gatinhos (plural)
#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:42
msgid "Main Window of Kitties showing an image of Rory"
msgstr "Janela principal do app Gatinhos mostrando uma imagem do Rory"

# Coloquei do app Gatinhos em vez de do Gatinhos pois
# do (singular) briga não fica bem acompanhado de Gatinhos (plural)
#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:46
msgid "Main Window of Kitties showing an image of Goober with “Cat & Image Picker” Menu open"
msgstr "Janela principal do app Gatinhos mostrando uma imagem do Goober com o menu “Cat & Image Picker”"

# Coloquei do app Gatinhos em vez de do Gatinhos pois
# do (singular) briga não fica bem acompanhado de Gatinhos (plural)
#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:50
msgid "Main Window of Kitties showing an image of Gary with “Cat & Image Picker” Menu and Cat Picker open"
msgstr ""
"Janela principal do app Gatinhos mostrando uma imagem do Gary com o menu “Selecionador por gato e imagem”"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:6
msgid "Currently selected cat"
msgstr "Gato selecionado"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:7
msgid "Name of the currently selected cat"
msgstr "Nome do gato selecionado"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:13
msgid "Starred Images"
msgstr "Imagens favoritas"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:14
msgid "Starred Images as an array. Format: (cats-name)(id)"
msgstr "Imagens favoritas como uma matriz. Formato (cats-name)(id)"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:20
msgid "Amount of Images to store"
msgstr "Quantidade de imagens para armazenar"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:21
msgid "How much cat images should be stored in history"
msgstr "Quantas imagens de gatos devem ser armazenadas no histórico"

