msgctxt "Button tooltip"
msgid "Main Menu"
msgstr "Menu principal"

#. Text for the banner, which displays when the random image number or the image data could not be fetched
#: src/window.blp:133
msgctxt "Banner"
msgid "A problem occurred while getting the image."
msgstr "Ocorreu um problema ao obter a imagem."

#. Button for the action of both banners
#: src/window.blp:135 src/window.blp:148
msgctxt "Banner icon"
msgid "Try Again"
msgstr "Tentar de novo"

#. Text for the banner, which displays when the output is a 404 page
#: src/window.blp:140
msgctxt "Banner"
msgid "This Image does not exist."
msgstr "Esta imagem não existe."

#. Button for the action of the banner
#: src/window.blp:142
msgctxt "Banner icon"
msgid "Randomize"
msgstr "Aleatório"

#. Text for the banner, which displays when the image could not be displayed
#: src/window.blp:147
msgctxt "Banner"
msgid "A problem occurred while displaying the image."
msgstr "Ocorreu um problema ao exibir a imagem."

#: src/window.blp:166
