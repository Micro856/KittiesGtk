#. This name is generic enough. Go ahead translate it.
#: data/io.github.Micro856.KittiesGtk.desktop.in.in:2
#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:7
#: src/application.vala:65 src/window.blp:6 src/window.blp:13
msgid "Kitties"
msgstr "Katzen"

#: data/io.github.Micro856.KittiesGtk.desktop.in.in:8
msgid "GTK;Cat;Cats;Kitty;Feline;Felines;Meow;Gary;Goober;Gully;Garfield;Rory;API;Image;Download;Random;"
msgstr "GTK;Katze;Katzen;Kater;Kätzchen;Mieze;Miau;Gary;Goober;Gully;Garfield;Rory;API;Bild;Herunterladen;Zufall"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:8
msgid "View random images of felines"
msgstr "Zufällige Katzenbilder betrachten"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:10
msgid ""
"Kitties is an app that lets you display a random image of one of the "
"available cats."
msgstr ""
"Katzen ist eine App mit der Sie ein zufälliges Bild von einen der "
"verfügbaren Katzen betrachten können."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:11
msgid ""
"These pictures come from various APIs including api.garythe.cat and rory.cat."
msgstr ""
"Diese Bilder kommen von mehreren APIs wie api.garythe.cat und rory.cat."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:12
msgid "Features:"
msgstr "Funktionen:"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:14
msgid "Support for Multiple APIs"
msgstr "Unterstützung für mehrere APIs"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:15
msgid "Saving & Copying Cat Images"
msgstr "Katzenbilder speichern & kopieren"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:16
msgid "Keyboard Navigation"
msgstr "Tastaturnavigation"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:21
msgid "Marcel Mrówka"
msgstr "Marcel Mrówka"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:42
msgid "Main Window of Kitties showing an image of Rory"
msgstr "Hauptfenster von Katzen zeigt ein Bild von Rory"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:46
msgid ""
"Main Window of Kitties showing an image of Goober with “Cat & Image Picker” "
"Menu open"
msgstr ""
"Hauptfenster von Katzen zeigt ein Bild von Goober mit dem „Katzen & "
"Bildauswahl“ Menü geöffnet."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in.in:50
msgid ""
"Main Window of Kitties showing an image of Gary with “Cat & Image Picker” "
"Menu and Cat Picker open"
msgstr ""
"Hauptfenster von Katzen zeigt ein Bild von Gary mit dem „Katzen & "
"Bildauswahl“ Menü und Katzenauswahl geöffnet."

#: data/io.github.Micro856.KittiesGtk.gschema.xml:6
msgid "Currently selected cat"
msgstr "Aktuell ausgewählte Katze"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:7
msgid "Name of the currently selected cat"
msgstr "Name der aktuell ausgewählten Katze"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:13
msgid "Starred Images"
msgstr "Favoriten"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:14
msgid "Starred Images as an array. Format: (cats-name)(id)"
msgstr "Favoriten als ein Array. Format: (katzen-name)(id)"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:20
msgid "Amount of Images to store"
msgstr "Anzahl der Bilder die gespeichert werden"

#: data/io.github.Micro856.KittiesGtk.gschema.xml:21
msgid "How much cat images should be stored in history"
msgstr "Wie viele Katzenbilder im Verlauf gespeichert werden"

