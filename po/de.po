#: src/window.blp:21
msgid "Cat & Image Picker"
msgstr "Katzen & Bildauswahl"

#. Title for selector of cats, this means the currently selected Cat is, kind of like "Cat:", but without ':'
#: src/window.blp:26
msgctxt "Cat selector"
msgid "Cat"
msgstr "Katze"

#. Title for the selector of the image, just like with the cat selector, this means ID number of the image to display
#: src/window.blp:33
msgctxt "Image selector"
msgid "Image Number"
msgstr "Bildnummer"

#. Tooltip for a button, which when pressed will go Backwards 1 step
#: src/window.blp:53
msgctxt "Button tooltip"
msgid "Back"
msgstr "Zurück"

#. Tooltip for a button, which when pressed will go Forwards 1 step
#: src/window.blp:61
msgctxt "Button tooltip"
msgid "Forward"
msgstr "Vor"

#. Tooltip for a button, which when pressed will display a random image
#: src/window.blp:69
msgctxt "Button tooltip"
msgid "Randomize Image"
msgstr "Zufälliges Bild"

#. Tooltip for a button, which when pressed will display the details of the image
#: src/window.blp:86
msgid "Image Details"
msgstr "Bilddetails"

#. An image property, works like "Cat:", for example if selected cat is Gary, it should be read as "Cat: Gary"
#: src/window.blp:92
msgctxt "Image details"
msgid "Cat"
msgstr "Katze"

#. An image property, works like "Cat:", for example if selected image is 2, it should be read as "Image number: 2"
#: src/window.blp:97
msgctxt "Image details"
msgid "Image Number"
msgstr "Bildnummer"

#: src/window.blp:101
msgctxt "Image details"
msgid "Image URL"
msgstr "Bild URL"

#. An image property, licence/license of the image
#: src/window.blp:107
msgctxt "Image details"
msgid "License"
msgstr "Lizenz"

#. An image property, the API used to fetch the cat image, if Gary is selected, it should be read as "API: api.garythe.cat"
#: src/window.blp:113
msgctxt "Image details"
msgid "API"
msgstr "API"

#. A tooltip for a button, which when pressed opens the main menu
#: src/window.blp:123
msgctxt "Button tooltip"
msgid "Main Menu"
msgstr "Hauptmenü"

#. Text for the banner, which displays when the random image number or the image data could not be fetched
#: src/window.blp:133
msgctxt "Banner"
msgid "A problem occurred while getting the image."
msgstr "Beim Erstellen des Bildes trat ein Problem auf."

#. Button for the action of both banners
#: src/window.blp:135 src/window.blp:148
msgctxt "Banner icon"
msgid "Try Again"
msgstr "Nochmals versuchen"

#. Text for the banner, which displays when the output is a 404 page
#: src/window.blp:140
msgctxt "Banner"
msgid "This Image does not exist."
msgstr "Dieses Bild existiert nicht."

#. Button for the action of the banner
#: src/window.blp:142
msgctxt "Banner icon"
msgid "Randomize"
msgstr "Zufälliges Bild"

#. Text for the banner, which displays when the image could not be displayed
#: src/window.blp:147
msgctxt "Banner"
msgid "A problem occurred while displaying the image."
msgstr "Bei der Anzeige des Bildes trat ein Problem auf."

#: src/window.blp:166
msgctxt "Starred Page Title"
msgid "Starred"
msgstr "Favoriten"

#. Little popup that appears when file was saved
#: src/window.blp:186
msgctxt "Toast"
msgid "File saved successfully!"
msgstr "Datei erfolgreich gespeichert!"

#. Little popup if the file wasn't saved correctly
#: src/window.blp:191
msgctxt "Toast"
msgid "A problem occurred while saving the image."
msgstr "Beim Speichern des Bildes trat ein Problem auf."

#. Little popup that appears when user cancells saving
#: src/window.blp:196
msgctxt "Toast"
msgid "File saving cancelled"
msgstr "Datei speichern abgebrochen"

#. Little popup that appears when user copies an image
#: src/window.blp:201
msgctxt "Toast"
msgid "Copied to Clipboard!"
msgstr "In die Zwischenablage kopiert!"

#: src/window.blp:207
msgctxt "Starred"
msgid "No Starred Images"
msgstr "Keine Favoriten"

#: src/window.blp:208
msgctxt "Starred"
msgid "Try using the “Mark as Starred” button"
msgstr "Probieren Sie den „Favorit hinzufügen“ Knopf aus"

