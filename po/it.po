#. This name is generic enough. Go ahead translate it.
#: data/io.github.Micro856.KittiesGtk.desktop.in:2
#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:7 src/application.vala:57
#: src/window.blp:6
msgid "Kitties"
msgstr "Gattini"

#: data/io.github.Micro856.KittiesGtk.desktop.in:8
msgid "GTK;Cat;Cats;Kitty;Feline;Felines;Meow;Gary;Goober;Gully;Garfield;Rory;API;Image;Download;Random;"
msgstr "GTK;Gatto;Gatti;Gattino;Gattini;Felino;Felini;Miao;Gary;Goober;Gully;Garfield;Rory;API;Immagine;Scarica;Casuale;"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:8
msgid "View random images of felines"
msgstr "Guarda immagini casuali di felini"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:10
msgid ""
"Kitties is an app that lets you display a random image of one of the "
"available cats."
msgstr ""
"Gattini è un'app che ti permette di mostrare un'immagine casuale di uno dei "
"gatti disponibili."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:11
msgid ""
"These pictures come from various APIs including api.garythe.cat and rory.cat."
msgstr ""
"Queste immagini provengono da varie API, tra cui api.garythe.cat e rory.cat."

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:12
msgid "Features:"
msgstr "Funzionalità:"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:14
msgid "Support for Multiple APIs"
msgstr "Supporto per più API"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:15
msgid "Saving Cat Images"
msgstr "Salvataggio delle immagini dei gatti"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:16
msgid "Keyboard Navigation"
msgstr "Navigazione da tastiera"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:21
msgid "Marcel Mrówka"
msgstr "Marcel Mrówka"

#: data/io.github.Micro856.KittiesGtk.metainfo.xml.in:42
msgid "Main Window of Kitties showing an image of Gary"
msgstr "Finestra principale di Gattini che mostra un'immagine di Gary"

