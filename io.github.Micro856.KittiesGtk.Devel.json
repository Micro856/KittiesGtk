// For stable building take a look at https://github.com/flathub/io.github.Micro856.KittiesGtk/blob/master/io.github.Micro856.KittiesGtk.json
{
    "id" : "io.github.Micro856.KittiesGtkDevel",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "51",
    "sdk" : "org.gnome.Sdk",
    "command" : "kittiesgtk",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "modules" : [
        {
            "name" : "kittiesgtk",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
            	"-Dprofile=devel"
            ],
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
