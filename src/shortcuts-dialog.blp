using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
      Adw.ShortcutsSection {
            // Title of the keyboard shortcut category
            title: C_("Shortcut category", "General");
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Show Starred");
                  action-name: "win.open_starred";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Show Preferences");
                  action-name: "win.preferences";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Show Shortcuts");
                  action-name: "app.shortcuts";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Quit");
                  action-name: "app.quit";
                }
          }
      Adw.ShortcutsSection {
            // Tile of the keyboard shortcut category, things done to/with the image
            title: C_("Shortcut category", "Image History");
             Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Go Back");
                  action-name: "win.go_back";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Go Forward");
                  action-name: "win.go_next";
                }
          }
      Adw.ShortcutsSection {
            // Tile of the keyboard shortcut category, things done to/with the image
            title: C_("Shortcut category", "Image");
             Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Copy Image");
                  action-name: "win.copy";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Enter Image Number");
                  action-name: "win.img_number";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Increase Image Number");
                  action-name: "win.add_one";
            }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Decrease Image Number");
                  action-name: "win.rm_one";
            }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Mark/Unmark as Starred");
                  action-name: "win.mark_starred";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Randomize Image");
                  action-name: "win.randomize";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Save Image");
                  action-name: "win.save";
                }
          }
      Adw.ShortcutsSection {
            // Name of the keyboard shortcut category, selecting cats form keyboard
            title: C_("Shortcut category", "Cat Selection");
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Garfield");
                  action-name: "win.switch_to_garfield";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Gary");
                  action-name: "win.switch_to_gary";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Goober");
                  action-name: "win.switch_to_goober";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Gully");
                  action-name: "win.switch_to_gully";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Rory");
                  action-name: "win.switch_to_rory";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Surprise");
                  action-name: "win.switch_to_surprise";
                }
          }
    }