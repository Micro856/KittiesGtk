using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
      Adw.ShortcutsSection {
            // Title of the keyboard shortcut category
            title: C_("Shortcut category", "General");
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Show Shortcuts");
                  action-name: "app.shortcuts";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Quit");
                  action-name: "app.quit";
                }
          }
      Adw.ShortcutsSection {
            // Tile of the keyboard shortcut category, things done to/with the image
            title: C_("Shortcut category", "Image");
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Enter Image Number");
                  action-name: "win.img_number";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Randomize Image");
                  action-name: "win.randomize";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Save Image");
                  action-name: "win.save";
                }
          }
      Adw.ShortcutsSection {
            // Name of the keyboard shortcut category, selecting cats form keyboard
            title: C_("Shortcut category", "Cat Selection");
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Garfield");
                  action-name: "win.switch_to_garfield";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Gary");
                  action-name: "win.switch_to_gary";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Goober");
                  action-name: "win.switch_to_goober";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Gully");
                  action-name: "win.switch_to_gully";
                }
            Adw.ShortcutsItem {
                  // Name of the keyboard shortcut
                  title: C_("Shortcut", "Switch to Rory");
                  action-name: "win.switch_to_rory";
                }
          }
    }