using Gtk 4.0;
using Adw 1;

template $KittiesgtkWindow: Adw.ApplicationWindow {
  title: _("Kitties");
  default-width: 800;
  default-height: 600;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
          [end]
          MenuButton {
                primary: true;
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;
          }
      }

    Gtk.Label label {
      label: _("Hello, World!");
      styles ["title-1"]
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Kitties");
      action: "app.about";
    }
  }
}