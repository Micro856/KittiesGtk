using Gtk 4.0;
using Adw 1;

template $KittiesgtkWindow: Adw.ApplicationWindow {
  title: _("Kitties");
  default-width: 740;
  default-height: 600;

  Adw.ToastOverlay file_action {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: MenuButton cat_popover {
                        primary: false;
                        tooltip-text: _("Cat & Image Selector");
                        popover: Popover {
                          Adw.PreferencesGroup {
                            Adw.ComboRow cat_selector {
                              title: _("Cat");
                              model: StringList {
                                strings: ["Garfield", "Gary", "Goober", "Gully", "Rory"];
                              };
                              selected: 1;
                            }
                            Adw.SpinRow cat_id_button {
                              title: _("Image Number");
                              adjustment: Adjustment {
                                lower: 0;
                                upper: 1000;
                              step-increment: 1;
                              };
                              digits: 0;
                            }
                          }
                        };
        };
      [start]
      Box {
        spacing: 6;
        Button dice {
          halign: center;
          valign: end;
          icon-name: "dice-symbolic";
          tooltip-text: _("Randomize Image");
        }
        Button getting {
          halign: center;
          valign: end;
          icon-name: "document-save-symbolic";
          tooltip-text: _("Save Image");
        }
      }
      [end]
      Box {
        spacing: 6;
        MenuButton {
          primary: false;
          icon-name: "info-outline-symbolic";
          tooltip-text: _("Image Details");
          popover: Popover {
            Adw.PreferencesGroup {
              Adw.ActionRow info_cat {
                styles ["property"]
                title: _("Cat");
              }
              Adw.ActionRow info_id {
                styles ["property"]
                title: _("Image Number");
              }
              Adw.ActionRow info_url {
                styles ["property"]
                title: _("Image URL");
                use-markup: true;
              }
              Adw.ActionRow info_copying {
                styles ["property"]
                title: _("Lincense");
                use-markup: true;
              }
              Adw.ActionRow info_api {
                styles ["property"]
                title: _("API");
                use-markup: true;
              }
            }
          };
        }
        MenuButton {
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }
      }
    }
      Box {
        orientation: vertical;

        Adw.Banner data_issue {
          title: _("A problem occurred while getting the image.");
          button-label: _("Try Again");
          revealed: false;
        }
        Picture picture {
          can-shrink: true;
          content-fit: contain;
          halign: center;
          valign: center;
        }
      }
      Adw.Toast file_saved {
        title: _("File saved successfully!");
        timeout: 3;
      }
      Adw.Toast file_error {
        title: _("A problem occurred while saving the image.");
      }
      Adw.Toast file_cancelled {
        title: _("File saving cancelled");
        timeout: 3;
      }
  }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Kitties");
      action: "app.about";
    }
  }
}
