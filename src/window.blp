using Gtk 4.0;
using Adw 1;

template $KittiesgtkWindow: Adw.ApplicationWindow {
  title: _("Kitties");
  default-width: 740;
  default-height: 600;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
          title-widget: Box {
            orientation: horizontal;
            spacing: 6;
            DropDown cat_selector {
              model: StringList {
                strings: ["Garfield", "Gary", "Goober", "Gully", "Rory"];
              };
              selected: 1;
            }
            MenuButton {
              primary: false;
              icon-name: "image-symbolic";
              tooltip-text: _("Image selector");
              popover: Popover {
                Adw.PreferencesGroup {
                  Adw.SpinRow cat_id_button {
                    title: _("Picture number");
                    adjustment: Adjustment {
                      lower: 1;
                      upper: 1000;
                      step-increment: 1;
                    };
                    digits: 0;
                  }
                }
              };
            }
          };
          [start]
          Button dice {
            halign: center;
            valign: end;
            icon-name: "dice-symbolic";
            tooltip-text: _("Randomize");
          }
          [end]
          Box {
            spacing: 6;
            MenuButton {
              primary: false;
              icon-name: "info-outline-symbolic";
              tooltip-text: _("Image details");
              popover: Popover {
                Adw.PreferencesGroup {
                  Adw.ActionRow info_cat {
                        styles ["property"]
                        title: _("Cat");
                  }
                  Adw.ActionRow info_id {
                        styles ["property"]
                        title: _("Picture number");
                  }
                  Adw.ActionRow info_url {
                        styles ["property"]
                        title: _("URL");
                        use-markup: true;
                  }
                  Adw.ActionRow info_copying {
                        styles ["property"]
                        title: _("Lincense");
                        use-markup: true;
                  }
                  Adw.ActionRow info_api {
                        styles ["property"]
                        title: _("API");
                        use-markup: true;
                  }
                }
              };
            }
            MenuButton {
                primary: true;
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;
            }
          }
      }
      Box {
        orientation: vertical;

        Adw.Banner data_issue {
          title: _("A problem occured while getting the image.");
          button-label: _("Try Again");
          revealed: false;
        }
        Picture picture {
          can-shrink: true;
          content-fit: contain;
          halign: center;
          valign: center;
        }
      }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Kitties");
      action: "app.about";
    }
  }
}