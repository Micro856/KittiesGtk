using Gtk 4.0;
using Adw 1;

template $KittiesgtkWindow: Adw.ApplicationWindow {
  title: _("Kitties");
  default-width: 800;
  default-height: 600;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
          title-widget: DropDown cat_selector {
                          model: StringList {
                          strings: ["Gary", "Goober", "Rory"];
                          };
                        };
          [start]
          Button dice {
            halign: center;
            valign: end;
            icon-name: "dice-symbolic";
            tooltip-text: _("Randomize");
          }
          [end]
          MenuButton {
                primary: true;
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;
          }
      }
      Box {
        orientation: vertical;

        Adw.Banner data_issue {
          title: _("A problem occured while getting the image.");
          button-label: _("Try Again");
          revealed: false;
        }

        Picture picture {
          can-shrink: true;
          content-fit: contain;
          halign: center;
          valign: center;
        }
      }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }
    item {
      label: _("_About Kitties");
      action: "app.about";
    }
  }
}