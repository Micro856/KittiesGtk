<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Micro856.KittiesGtk</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Kitties</name>
  <summary>View random images of felines</summary>
  <description>
    <p>Kitties is an app that lets you display a random image of one of the available cats.</p>
    <p>These pictures come from various APIs including api.garythe.cat and rory.cat.</p>
    <p></p>
    <p>Features:</p>
    <ul>
      <li>Support for Multiple APIs</li>
      <li>Saving Cat Images</li>
      <li>Keyboard Navigation</li>
    </ul>
  </description>

  <developer id="tld.vendor">
    <name>Marcel Mrówka</name>
  </developer>

  <url type="homepage">https://github.org/Micro856/KittiesGtk</url>
  <url type="vcs-browser">https://github.org/Micro856/KittiesGtk</url>
  <url type="bugtracker">https://github.org/Micro856/KittiesGtk/issues</url>
  <url type="translate">https://github.org/Micro856/KittiesGtk/tree/main/po</url>
  <url type="contribute">https://github.org/Micro856/KittiesGtk</url>

  <translation type="gettext">kittiesgtk</translation>
  <launchable type="desktop-id">io.github.Micro856.KittiesGtk.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#c64600</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Micro856/KittiesGtk/refs/heads/master/data/screenshots/Main-UI.png</image>
      <caption>Main Window of Kitties showing an image of Gary</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.0.0" date="2026-10-00">
      <url type="details">https://github.com/Micro856/KittiesGtk/releases/tag/1.0.0</url>
      <description translate="no">
        <p>Initial release</p>
        <p>Kitties is an app that lets you display a random image of one of the available cats.</p>
        <p>These pictures come from various APIs including api.garythe.cat and rory.cat.</p>
      </description>
    </release>
  </releases>
</component>
