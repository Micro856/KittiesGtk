<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Kitties</name>
  <summary>View random images of felines</summary>
  <description>
    <p>Kitties is an app that lets you display a random image of one of the available cats.</p>
    <p>These pictures come from various APIs including api.garythe.cat and rory.cat.</p>
    <p>Features:</p>
    <ul>
      <li>Support for Multiple APIs</li>
      <li>Saving &amp; Copying Cat Images</li>
      <li>Keyboard Navigation</li>
    </ul>
  </description>

  <developer id="io.github.Micro856">
    <name>Marcel Mrówka</name>
  </developer>

  <url type="homepage">https://github.com/Micro856/KittiesGtk</url>
  <url type="vcs-browser">https://github.com/Micro856/KittiesGtk</url>
  <url type="bugtracker">https://github.com/Micro856/KittiesGtk/issues</url>
  <url type="translate">https://github.com/Micro856/KittiesGtk/tree/master/po</url>
  <url type="contribute">https://github.com/Micro856/KittiesGtk</url>

  <translation type="gettext">kittiesgtk</translation>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#c64600</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Micro856/KittiesGtk/refs/heads/master/data/screenshots/1-rory.png</image>
      <caption>Main Window of Kitties showing an image of Rory</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Micro856/KittiesGtk/refs/heads/master/data/screenshots/2-goober.png</image>
      <caption>Main Window of Kitties showing an image of Goober with “Cat &amp; Image Picker” Menu open</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Micro856/KittiesGtk/refs/heads/master/data/screenshots/3-gary.png</image>
      <caption>Main Window of Kitties showing an image of Gary with “Cat &amp; Image Picker” Menu and Cat Picker open</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.2.0" date="2026-11-23">
      <url type="details">https://github.com/Micro856/KittiesGtk/releases/tag/1.2.0</url>
      <description translate="no">
        <ul>
          <li>Added the ability to mark images as Starred</li>
          <li>Added the ability to switch between recent images</li>
          <li>Improved Keyboard Navigation</li>
          <li>New Translations were added</li>
          <li>Translations were updated</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-11-11">
      <url type="details">https://github.com/Micro856/KittiesGtk/releases/tag/1.1.0</url>
      <description translate="no">
        <ul>
          <li>Added the ability to copy displayed image to the clipboard</li>
          <li>Stopped images from disappearing when getting a new one, unless it comes form a different API</li>
          <li>Started disabling Details button when errors occur</li>
          <li>Started disabling Randomize button and keyboard shortcut to avoid many requests</li>
          <li>The App Icon was recreated</li>
          <li>Translations were updated</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-31">
      <url type="details">https://github.com/Micro856/KittiesGtk/releases/tag/1.0.0</url>
      <description translate="no">
        <p>Initial release</p>
        <p>Kitties is an app that lets you display a random image of one of the available cats.</p>
        <p>These pictures come from various APIs including api.garythe.cat and rory.cat.</p>
      </description>
    </release>
  </releases>
</component>
